#!/bin/zsh
set -euo pipefail

script_dir=$(cd "$(/usr/bin/dirname "$0")" && /bin/pwd -P)
repo_dir=$(cd "$script_dir/.." && /bin/pwd -P)

fail() {
    /bin/echo "Repository check failed: $1" >&2
    exit 65
}

git -C "$repo_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "run this check from a Git checkout"
git -C "$repo_dir" diff --check
git -C "$repo_dir" diff --cached --check
if git -C "$repo_dir" grep --cached -n -I -E '[[:blank:]]+$' >/dev/null 2>&1; then
    fail "tracked source contains trailing whitespace"
fi

for script in "$repo_dir"/scripts/*; do
    [[ -f "$script" ]] || continue
    [[ -x "$script" ]] || fail "script is not executable: ${script#"$repo_dir/"}"
    /bin/zsh -n "$script"
done

for plist in "$repo_dir"/entitlements/*.plist; do
    /usr/bin/plutil -lint "$plist" >/dev/null
done
[[ -f "$repo_dir/controller/Info.plist" ]] || fail "controller Info.plist is missing"
/usr/bin/plutil -lint "$repo_dir/controller/Info.plist" >/dev/null || fail "controller Info.plist is invalid"

/usr/bin/make -C "$repo_dir/tools" syntax

controller_dir="$repo_dir/controller"
controller_main="$controller_dir/main.m"
controller_icon="$controller_dir/generate-icon.m"
controller_policy="$controller_dir/path_policy.c"
controller_policy_header="$controller_dir/path_policy.h"
controller_policy_tests="$controller_dir/tests/path_policy_tests.c"
for controller_source in \
    "$controller_main" \
    "$controller_icon" \
    "$controller_policy" \
    "$controller_policy_header" \
    "$controller_policy_tests"; do
    [[ -f "$controller_source" && ! -L "$controller_source" ]] || \
        fail "controller source is missing or linked: ${controller_source#"$repo_dir/"}"
done

controller_network_api_pattern='(^|[^[:alnum:]_])(socket|connect|connectx|bind|listen|accept|accept4|send|sendto|sendmsg|recv|recvfrom|recvmsg|getaddrinfo|getnameinfo|gethostbyname|gethostbyaddr)[[:space:]]*\('
controller_network_identifier_pattern='(^|[^[:alnum:]_])(NSURLSession|NSURLConnection|NSMutableURLRequest|NSURLRequest|CFStreamCreatePairWithSocket|CFStreamCreatePairWithSocketToHost|CFSocket[A-Za-z0-9_]*)([^[:alnum:]_]|$)'
controller_network_import_pattern='^[[:space:]]*(#[[:space:]]*(import|include)[[:space:]]*[<"](Network|CFNetwork|SystemConfiguration|WebKit)(/|[.>"])|@import[[:space:]]+(Network|CFNetwork|SystemConfiguration|WebKit)[[:space:]]*;)'
if /usr/bin/grep -E -n -q -- "$controller_network_api_pattern" \
    "$controller_main" "$controller_icon" "$controller_policy" "$controller_policy_header"; then
    fail "controller source calls a forbidden direct networking API"
fi
if /usr/bin/grep -E -n -q -- "$controller_network_identifier_pattern" \
    "$controller_main" "$controller_icon" "$controller_policy" "$controller_policy_header"; then
    fail "controller source references a forbidden Foundation or Core Foundation networking API"
fi
if /usr/bin/grep -E -n -q -- "$controller_network_import_pattern" \
    "$controller_main" "$controller_icon" "$controller_policy" "$controller_policy_header"; then
    fail "controller source imports a forbidden networking or web framework"
fi

/usr/bin/xcrun clang \
    -fobjc-arc \
    -std=c11 \
    -Wall -Wextra -Werror \
    -Wno-deprecated-declarations \
    -mmacosx-version-min=14.0 \
    -I "$controller_dir" \
    -fsyntax-only \
    "$controller_main" || fail "controller main source does not compile cleanly"
/usr/bin/xcrun clang \
    -fobjc-arc \
    -Wall -Wextra -Werror \
    -Wno-deprecated-declarations \
    -fsyntax-only \
    "$controller_icon" || fail "controller icon source does not compile cleanly"
/usr/bin/xcrun clang \
    -std=c11 \
    -Wall -Wextra -Werror \
    -I "$controller_dir" \
    -fsyntax-only \
    "$controller_policy" \
    "$controller_policy_tests" || fail "controller path-policy sources do not compile cleanly"

controller_check_root=$(/usr/bin/mktemp -d /tmp/displaylink-controller-source-check.XXXXXX) || \
    fail "could not create controller test directory"
cleanup_controller_check() {
    if [[ -n "${controller_check_root:-}" && -d "$controller_check_root" && \
        "$controller_check_root" == /tmp/displaylink-controller-source-check.* ]]; then
        /bin/rm -rf -- "$controller_check_root"
    fi
}
trap cleanup_controller_check EXIT INT TERM HUP

controller_policy_test_binary="$controller_check_root/path-policy-tests"
/usr/bin/xcrun clang \
    -std=c11 \
    -Wall -Wextra -Werror \
    -I "$controller_dir" \
    "$controller_policy" \
    "$controller_policy_tests" \
    -o "$controller_policy_test_binary" || fail "could not compile controller path-policy tests"
"$controller_policy_test_binary" || fail "controller path-policy tests failed"

controller_smoke_binary="$controller_check_root/controller-smoke"
(
    cd "$controller_check_root"
    /usr/bin/xcrun clang \
        -fobjc-arc \
        -std=c11 \
        -Wall -Wextra -Werror \
        -Wno-deprecated-declarations \
        -mmacosx-version-min=14.0 \
        -arch x86_64 \
        -arch arm64 \
        -I "$controller_dir" \
        "$controller_main" \
        "$controller_policy" \
        -framework AppKit \
        -o "$controller_smoke_binary"
) || fail "could not link the universal controller from source"
[[ "$(/usr/bin/lipo -archs "$controller_smoke_binary")" == "x86_64 arm64" ]] || \
    fail "source-built controller does not contain exactly x86_64 and arm64"

controller_forbidden_symbol_pattern='^[[:space:]]*(_(socket|connect|connectx|bind|listen|accept|accept4|send|sendto|sendmsg|recv|recvfrom|recvmsg|getaddrinfo|getnameinfo|gethostbyname|gethostbyaddr|CFStreamCreatePairWithSocket|CFStreamCreatePairWithSocketToHost|CFSocket[A-Za-z0-9_]*)([$][^[:space:]]+)?|_OBJC_CLASS_[$]_(NSURLSession|NSURLConnection|NSMutableURLRequest|NSURLRequest))[[:space:]]*$'
for architecture in x86_64 arm64; do
    controller_smoke_symbols="$controller_check_root/controller-smoke-$architecture.symbols"
    /usr/bin/nm -u -arch "$architecture" "$controller_smoke_binary" > "$controller_smoke_symbols" || \
        fail "could not inspect source-built controller imports ($architecture)"
    if /usr/bin/grep -E -q -- "$controller_forbidden_symbol_pattern" "$controller_smoke_symbols"; then
        fail "source-built controller imports a forbidden networking API ($architecture)"
    fi
done

controller_icon_generator="$controller_check_root/generate-icon"
controller_icon_output="$controller_check_root/ControllerIcon.icns"
controller_icon_probe="$controller_check_root/ControllerIcon.iconset"
(
    cd "$controller_check_root"
    /usr/bin/xcrun clang \
        -fobjc-arc \
        -Wall -Wextra -Werror \
        -Wno-deprecated-declarations \
        -framework AppKit \
        "$controller_icon" \
        -o "$controller_icon_generator"
) || fail "could not link the controller icon generator from source"
"$controller_icon_generator" "$controller_icon_output" || fail "controller icon generator failed"
/usr/bin/iconutil -c iconset "$controller_icon_output" -o "$controller_icon_probe" >/dev/null || \
    fail "source-generated controller icon is not a valid ICNS file"
[[ -d "$controller_icon_probe" ]] || fail "source-generated controller icon could not be extracted"

clean_room_dir="$repo_dir/clean-room"
for clean_room_source in \
    "$clean_room_dir/dock_probe.c" \
    "$clean_room_dir/probe_model.c" \
    "$clean_room_dir/probe_model.h" \
    "$clean_room_dir/descriptor_model.c" \
    "$clean_room_dir/descriptor_model.h" \
    "$clean_room_dir/standard_descriptor_reader.m" \
    "$clean_room_dir/observation_model.c" \
    "$clean_room_dir/observation_model.h" \
    "$clean_room_dir/transcript_check.c" \
    "$clean_room_dir/transport.c" \
    "$clean_room_dir/transport.h" \
    "$clean_room_dir/fake_transport.c" \
    "$clean_room_dir/fake_transport.h" \
    "$clean_room_dir/state_machine.c" \
    "$clean_room_dir/state_machine.h" \
    "$clean_room_dir/fake_dock_lab.c" \
    "$clean_room_dir/activation_model.c" \
    "$clean_room_dir/activation_model.h" \
    "$clean_room_dir/activation_replay.c" \
    "$clean_room_dir/activation_replay.h" \
    "$clean_room_dir/activation_check.c" \
    "$clean_room_dir/exchange_parser.c" \
    "$clean_room_dir/exchange_parser.h" \
    "$clean_room_dir/exchange_lab.c" \
    "$clean_room_dir/protocol_transfer.h" \
    "$clean_room_dir/partial_order_matcher.c" \
    "$clean_room_dir/partial_order_matcher.h" \
    "$clean_room_dir/qualified_sequences.c" \
    "$clean_room_dir/qualified_sequences.h" \
    "$clean_room_dir/transition_parser.c" \
    "$clean_room_dir/transition_parser.h" \
    "$clean_room_dir/traffic_regime.c" \
    "$clean_room_dir/traffic_regime.h" \
    "$clean_room_dir/protocol_model_lab.c" \
    "$clean_room_dir/fuzz/transition_parser_fuzz.c" \
    "$clean_room_dir/etw_metadata_import.py" \
    "$clean_room_dir/tests/probe_model_tests.c" \
    "$clean_room_dir/tests/descriptor_model_tests.c" \
    "$clean_room_dir/tests/observation_model_tests.c" \
    "$clean_room_dir/tests/fake_transport_tests.c" \
    "$clean_room_dir/tests/state_machine_tests.c" \
    "$clean_room_dir/tests/activation_model_tests.c" \
    "$clean_room_dir/tests/exchange_parser_tests.c" \
    "$clean_room_dir/tests/partial_order_matcher_tests.c" \
    "$clean_room_dir/tests/qualified_sequences_tests.c" \
    "$clean_room_dir/tests/transition_parser_tests.c" \
    "$clean_room_dir/tests/traffic_regime_tests.c" \
    "$clean_room_dir/tests/test_etw_metadata_import.py" \
    "$clean_room_dir/tests/test_facts_registry.py" \
    "$clean_room_dir/facts.tsv" \
    "$clean_room_dir/FACTS.md" \
    "$clean_room_dir/OFFLINE-PROTOCOL-MODEL.md"; do
    [[ -f "$clean_room_source" && ! -L "$clean_room_source" ]] || \
        fail "clean-room source is missing or linked: ${clean_room_source#"$repo_dir/"}"
    clean_room_relative=${clean_room_source#"$repo_dir/"}
    git -C "$repo_dir" ls-files --error-unmatch -- \
        "$clean_room_relative" >/dev/null 2>&1 || \
        fail "required clean-room source is not tracked: $clean_room_relative"
done
PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 \
    "$clean_room_dir/tests/test_etw_metadata_import.py" || \
    fail "ETW metadata importer tests failed"
PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 \
    "$clean_room_dir/tests/test_facts_registry.py" || \
    fail "clean-room fact registry is invalid"
clean_room_network_pattern='(^|[^[:alnum:]_])(socket|connect|connectx|bind|listen|accept|accept4|send|sendto|sendmsg|recv|recvfrom|recvmsg|getaddrinfo|getnameinfo|gethostbyname|gethostbyaddr)[[:space:]]*\('
if /usr/bin/grep -E -n -q -- "$clean_room_network_pattern" \
    "$clean_room_dir/dock_probe.c" "$clean_room_dir/probe_model.c" \
    "$clean_room_dir/probe_model.h" "$clean_room_dir/descriptor_model.c" \
    "$clean_room_dir/descriptor_model.h" "$clean_room_dir/standard_descriptor_reader.m" \
    "$clean_room_dir/observation_model.c" \
    "$clean_room_dir/observation_model.h" "$clean_room_dir/transcript_check.c" \
    "$clean_room_dir/transport.c" "$clean_room_dir/transport.h" \
    "$clean_room_dir/fake_transport.c" "$clean_room_dir/fake_transport.h" \
    "$clean_room_dir/state_machine.c" "$clean_room_dir/state_machine.h" \
    "$clean_room_dir/fake_dock_lab.c" \
    "$clean_room_dir/activation_model.c" "$clean_room_dir/activation_model.h" \
    "$clean_room_dir/activation_replay.c" "$clean_room_dir/activation_replay.h" \
    "$clean_room_dir/activation_check.c" \
    "$clean_room_dir/exchange_parser.c" "$clean_room_dir/exchange_parser.h" \
    "$clean_room_dir/exchange_lab.c" \
    "$clean_room_dir/protocol_transfer.h" \
    "$clean_room_dir/partial_order_matcher.c" \
    "$clean_room_dir/partial_order_matcher.h" \
    "$clean_room_dir/qualified_sequences.c" \
    "$clean_room_dir/qualified_sequences.h" \
    "$clean_room_dir/transition_parser.c" \
    "$clean_room_dir/transition_parser.h" \
    "$clean_room_dir/traffic_regime.c" \
    "$clean_room_dir/traffic_regime.h" \
    "$clean_room_dir/protocol_model_lab.c" \
    "$clean_room_dir/fuzz/transition_parser_fuzz.c"; then
    fail "clean-room probe calls a forbidden networking API"
fi

model_sources=(
    "$clean_room_dir/protocol_transfer.h"
    "$clean_room_dir/partial_order_matcher.c"
    "$clean_room_dir/partial_order_matcher.h"
    "$clean_room_dir/qualified_sequences.c"
    "$clean_room_dir/qualified_sequences.h"
    "$clean_room_dir/transition_parser.c"
    "$clean_room_dir/transition_parser.h"
    "$clean_room_dir/traffic_regime.c"
    "$clean_room_dir/traffic_regime.h"
    "$clean_room_dir/protocol_model_lab.c"
    "$clean_room_dir/fuzz/transition_parser_fuzz.c"
    "$clean_room_dir/tests/partial_order_matcher_tests.c"
    "$clean_room_dir/tests/qualified_sequences_tests.c"
    "$clean_room_dir/tests/transition_parser_tests.c"
    "$clean_room_dir/tests/traffic_regime_tests.c"
    "$clean_room_dir/FACTS.md"
    "$clean_room_dir/OFFLINE-PROTOCOL-MODEL.md"
    "$clean_room_dir/facts.tsv"
)
captured_byte_array_pattern='(0x[0-9A-Fa-f]{2}([uU])?[[:space:]]*,[[:space:]]*){8}'
base64_blob_pattern='(^|[^A-Za-z0-9+/])[A-Za-z0-9+/]{80,}={0,2}([^A-Za-z0-9+/]|$)'
if /usr/bin/grep -E -n -q -- "$captured_byte_array_pattern" \
    "${model_sources[@]}"; then
    fail "offline protocol model contains a prohibited long byte-literal array"
fi
if /usr/bin/grep -E -n -q -- "$base64_blob_pattern" \
    "${model_sources[@]}"; then
    fail "offline protocol model contains a prohibited encoded data blob"
fi
if /usr/bin/grep -E -n -q -- 'kUSBSerialNumberString|USB Serial Number|serialNumber|IOPlatformSerialNumber' \
    "$clean_room_dir/dock_probe.c" "$clean_room_dir/probe_model.c" \
    "$clean_room_dir/probe_model.h" "$clean_room_dir/descriptor_model.c" \
    "$clean_room_dir/descriptor_model.h" "$clean_room_dir/standard_descriptor_reader.m" \
    "$clean_room_dir/observation_model.c" \
    "$clean_room_dir/observation_model.h" "$clean_room_dir/transcript_check.c"; then
    fail "clean-room probe attempts to read a serial-number property"
fi
clean_room_mutating_usb_pattern='configureWithValue:|resetWithError:|sendDeviceRequest:|enqueueDeviceRequest:|IOUSBHostObjectInitOptionsDevice(Capture|Seize)'
if /usr/bin/grep -E -n -q -- "$clean_room_mutating_usb_pattern" \
    "$clean_room_dir/standard_descriptor_reader.m" \
    "$clean_room_dir/descriptor_model.c" "$clean_room_dir/descriptor_model.h"; then
    fail "standard descriptor reader references a forbidden mutating or ownership-seizing USB API"
fi
/usr/bin/grep -F -q 'options:IOUSBHostObjectInitOptionsNone' \
    "$clean_room_dir/standard_descriptor_reader.m" || \
    fail "standard descriptor reader does not visibly use the no-capture/no-seize option"
if /usr/bin/grep -F -q 'IORegistryEntryCreateCFProperties' \
    "$clean_room_dir/standard_descriptor_reader.m"; then
    fail "standard descriptor reader attempts to read the complete registry property set"
fi
/usr/bin/xcrun clang \
    -std=c11 \
    -Wall -Wextra -Werror \
    -I "$clean_room_dir" \
    -fsyntax-only \
    "$clean_room_dir/dock_probe.c" \
    "$clean_room_dir/probe_model.c" || fail "clean-room probe does not compile cleanly"
clean_room_probe_binary="$controller_check_root/clean-room-dock-probe"
/usr/bin/xcrun clang \
    -std=c11 \
    -Wall -Wextra -Werror \
    -I "$clean_room_dir" \
    "$clean_room_dir/dock_probe.c" \
    "$clean_room_dir/probe_model.c" \
    -framework IOKit \
    -framework CoreFoundation \
    -o "$clean_room_probe_binary" || fail "could not link clean-room probe"
clean_room_test_binary="$controller_check_root/clean-room-model-tests"
/usr/bin/xcrun clang \
    -std=c11 \
    -Wall -Wextra -Werror \
    -I "$clean_room_dir" \
    "$clean_room_dir/probe_model.c" \
    "$clean_room_dir/tests/probe_model_tests.c" \
    -o "$clean_room_test_binary" || fail "could not compile clean-room model tests"
"$clean_room_test_binary" || fail "clean-room model tests failed"
clean_room_descriptor_test_binary="$controller_check_root/clean-room-descriptor-tests"
/usr/bin/xcrun clang \
    -std=c11 \
    -Wall -Wextra -Werror \
    -I "$clean_room_dir" \
    "$clean_room_dir/descriptor_model.c" \
    "$clean_room_dir/tests/descriptor_model_tests.c" \
    -framework IOUSBHost \
    -o "$clean_room_descriptor_test_binary" || \
    fail "could not compile clean-room descriptor tests"
"$clean_room_descriptor_test_binary" || fail "clean-room descriptor tests failed"
clean_room_descriptor_reader="$controller_check_root/clean-room-standard-descriptor-reader"
/usr/bin/xcrun clang \
    -fobjc-arc \
    -std=c11 \
    -Wall -Wextra -Werror \
    -I "$clean_room_dir" \
    "$clean_room_dir/standard_descriptor_reader.m" \
    "$clean_room_dir/descriptor_model.c" \
    "$clean_room_dir/probe_model.c" \
    -framework IOUSBHost \
    -framework IOKit \
    -framework Foundation \
    -o "$clean_room_descriptor_reader" || \
    fail "could not link clean-room standard descriptor reader"
if /usr/bin/strings "$clean_room_descriptor_reader" | /usr/bin/grep -E -q -- \
    "$clean_room_mutating_usb_pattern"; then
    fail "standard descriptor reader binary references a forbidden mutating or ownership-seizing USB API"
fi
if "$clean_room_descriptor_reader" >/dev/null 2>&1; then
    fail "standard descriptor reader ran without its explicit opt-in flag"
else
    clean_room_descriptor_usage_status=$?
    [[ "$clean_room_descriptor_usage_status" == "64" ]] || \
        fail "standard descriptor reader returned an unexpected no-opt-in status"
fi
clean_room_observation_test_binary="$controller_check_root/clean-room-observation-tests"
/usr/bin/xcrun clang \
    -std=c11 \
    -Wall -Wextra -Werror \
    -I "$clean_room_dir" \
    "$clean_room_dir/observation_model.c" \
    "$clean_room_dir/probe_model.c" \
    "$clean_room_dir/tests/observation_model_tests.c" \
    -o "$clean_room_observation_test_binary" || \
    fail "could not compile clean-room observation tests"
"$clean_room_observation_test_binary" || fail "clean-room observation tests failed"
clean_room_transcript_binary="$controller_check_root/clean-room-transcript-check"
/usr/bin/xcrun clang \
    -std=c11 \
    -Wall -Wextra -Werror \
    -I "$clean_room_dir" \
    "$clean_room_dir/transcript_check.c" \
    "$clean_room_dir/observation_model.c" \
    "$clean_room_dir/probe_model.c" \
    -o "$clean_room_transcript_binary" || fail "could not link clean-room transcript checker"

fake_lab_sources=(
    "$clean_room_dir/transport.c"
    "$clean_room_dir/transport.h"
    "$clean_room_dir/fake_transport.c"
    "$clean_room_dir/fake_transport.h"
    "$clean_room_dir/state_machine.c"
    "$clean_room_dir/state_machine.h"
    "$clean_room_dir/fake_dock_lab.c"
    "$clean_room_dir/activation_model.c"
    "$clean_room_dir/activation_model.h"
    "$clean_room_dir/activation_replay.c"
    "$clean_room_dir/activation_replay.h"
    "$clean_room_dir/activation_check.c"
    "$clean_room_dir/exchange_parser.c"
    "$clean_room_dir/exchange_parser.h"
    "$clean_room_dir/exchange_lab.c"
    "$clean_room_dir/protocol_transfer.h"
    "$clean_room_dir/partial_order_matcher.c"
    "$clean_room_dir/partial_order_matcher.h"
    "$clean_room_dir/qualified_sequences.c"
    "$clean_room_dir/qualified_sequences.h"
    "$clean_room_dir/transition_parser.c"
    "$clean_room_dir/transition_parser.h"
    "$clean_room_dir/traffic_regime.c"
    "$clean_room_dir/traffic_regime.h"
    "$clean_room_dir/protocol_model_lab.c"
    "$clean_room_dir/fuzz/transition_parser_fuzz.c"
)
fake_hardware_api_pattern='IOUSBHost|IOKit/IOKitLib|IOService(Get|Open|Close|Matching)|IORegistryEntry|configureWithValue:|resetWithError:|sendDeviceRequest:|enqueueDeviceRequest:'
if /usr/bin/grep -E -n -q -- "$fake_hardware_api_pattern" "${fake_lab_sources[@]}"; then
    fail "fake transport lab references a real macOS USB or IOKit access API"
fi
if /usr/bin/grep -E -n -q -- 'db_transport_write[[:space:]]*\(' \
    "$clean_room_dir/state_machine.c"; then
    fail "protocol-gated state machine can call the transport write API"
fi

clean_room_fake_transport_test="$controller_check_root/clean-room-fake-transport-tests"
/usr/bin/xcrun clang \
    -std=c11 \
    -Wall -Wextra -Werror \
    -I "$clean_room_dir" \
    "$clean_room_dir/tests/fake_transport_tests.c" \
    "$clean_room_dir/fake_transport.c" \
    "$clean_room_dir/transport.c" \
    -o "$clean_room_fake_transport_test" || \
    fail "could not compile fake transport tests"
"$clean_room_fake_transport_test" || fail "fake transport tests failed"

clean_room_state_machine_test="$controller_check_root/clean-room-state-machine-tests"
/usr/bin/xcrun clang \
    -std=c11 \
    -Wall -Wextra -Werror \
    -I "$clean_room_dir" \
    "$clean_room_dir/tests/state_machine_tests.c" \
    "$clean_room_dir/state_machine.c" \
    "$clean_room_dir/fake_transport.c" \
    "$clean_room_dir/transport.c" \
    -o "$clean_room_state_machine_test" || \
    fail "could not compile state-machine tests"
"$clean_room_state_machine_test" || fail "state-machine tests failed"

clean_room_fake_lab="$controller_check_root/clean-room-fake-dock-lab"
/usr/bin/xcrun clang \
    -std=c11 \
    -Wall -Wextra -Werror \
    -I "$clean_room_dir" \
    "$clean_room_dir/fake_dock_lab.c" \
    "$clean_room_dir/state_machine.c" \
    "$clean_room_dir/fake_transport.c" \
    "$clean_room_dir/transport.c" \
    -o "$clean_room_fake_lab" || fail "could not link fake transport lab"
fake_lab_output="$controller_check_root/fake-lab-output.txt"
"$clean_room_fake_lab" > "$fake_lab_output" || fail "fake transport lab failed"
/usr/bin/grep -F -q 'write-attempts=0 successful-writes=0' "$fake_lab_output" || \
    fail "fake transport lab did not prove zero writes"
/usr/bin/grep -F -q 'PASS: activation is blocked' "$fake_lab_output" || \
    fail "fake transport lab did not stop at its protocol gate"
if /usr/bin/otool -L "$clean_room_fake_lab" | /usr/bin/grep -E -q -- \
    'IOKit|IOUSBHost'; then
    fail "fake transport lab links a real macOS USB or IOKit framework"
fi
fake_lab_symbols="$controller_check_root/fake-lab.symbols"
/usr/bin/nm -u "$clean_room_fake_lab" > "$fake_lab_symbols" || \
    fail "could not inspect fake transport lab imports"
if /usr/bin/grep -E -q -- '_(IOUSB|IOService|IORegistry|socket|connect|send|recv)' \
    "$fake_lab_symbols"; then
    fail "fake transport lab imports a hardware-access or networking symbol"
fi


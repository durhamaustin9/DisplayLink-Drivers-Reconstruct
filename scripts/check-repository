    -std=c11 \
    -Wall -Wextra -Werror \
    -I "$clean_room_dir" \
    "$clean_room_dir/exchange_lab.c" \
    "$clean_room_dir/exchange_parser.c" \
    "$clean_room_dir/fake_transport.c" \
    "$clean_room_dir/transport.c" \
    -o "$clean_room_exchange_lab" || fail "could not link first-burst lab"
exchange_lab_output="$controller_check_root/exchange-lab-output.txt"
"$clean_room_exchange_lab" > "$exchange_lab_output" || \
    fail "first-burst lab failed"
/usr/bin/grep -F -q 'order=canonical frames=15 writes=7 reads=8' \
    "$exchange_lab_output" || fail "first-burst lab lost the canonical order"
/usr/bin/grep -F -q \
    'order=canonical-role-indices-9-10-swapped frames=15 writes=7 reads=8' \
    "$exchange_lab_output" || fail "first-burst lab lost the observed adjacent swap"
/usr/bin/grep -F -q 'observed-variable-ranges=6 observed-variable-bytes=147' \
    "$exchange_lab_output" || fail "first-burst lab lost its control-qualified position mask"
/usr/bin/grep -F -q 'hardware remains disabled' "$exchange_lab_output" || \
    fail "first-burst lab did not retain its hardware-disabled boundary"
if /usr/bin/otool -L "$clean_room_exchange_lab" | /usr/bin/grep -E -q -- \
    'IOKit|IOUSBHost'; then
    fail "first-burst lab links a real macOS USB or IOKit framework"
fi
exchange_lab_symbols="$controller_check_root/exchange-lab.symbols"
/usr/bin/nm -u "$clean_room_exchange_lab" > "$exchange_lab_symbols" || \
    fail "could not inspect first-burst lab imports"
if /usr/bin/grep -E -q -- '_(IOUSB|IOService|IORegistry|socket|connect|send|recv)' \
    "$exchange_lab_symbols"; then
    fail "first-burst lab imports a hardware-access or networking symbol"
fi

/usr/bin/make -C "$clean_room_dir" test >/dev/null || \
    fail "complete clean-room model test suite failed"
/usr/bin/make -C "$clean_room_dir" test-sanitized >/dev/null || \
    fail "sanitized clean-room model test suite failed"


/usr/bin/nm -u "$clean_room_protocol_model_lab" > "$protocol_model_symbols" || \
    fail "could not inspect offline protocol-model lab imports"
if /usr/bin/grep -E -q -- '_(IOUSB|IOService|IORegistry|socket|connect|send|recv)' \
    "$protocol_model_symbols"; then
    fail "offline protocol-model lab imports hardware-access or networking symbols"
fi


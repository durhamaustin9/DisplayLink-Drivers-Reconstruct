        fail "offline protocol-model lab output lost: $required_model_output"
done
if /usr/bin/otool -L "$clean_room_protocol_model_lab" | \
    /usr/bin/grep -E -q -- 'IOKit|IOUSBHost'; then
    fail "offline protocol-model lab links a real macOS USB or IOKit framework"
fi

    -std=c11 \
    -Wall -Wextra -Werror \
    -I "$clean_room_dir" \
    "$clean_room_dir/protocol_model_lab.c" \
    "$clean_room_dir/transition_parser.c" \
    "$clean_room_dir/qualified_sequences.c" \
    "$clean_room_dir/partial_order_matcher.c" \
    "$clean_room_dir/traffic_regime.c" \
